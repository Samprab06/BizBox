# Copy to .env.local and fill in. Never commit real values.

# Server-only Postgres connection for health, migrations and source imports.
# Local Docker default (set only in .env.local):
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hackprinceton
DATABASE_URL=

# Local Docker database only. Set POSTGRES_PASSWORD in .env.local (local default: postgres).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=hackprinceton

# Optional local engine selection; sudo is never enabled implicitly.
CONTAINER_ENGINE=docker
CONTAINER_USE_SUDO=0
PODMAN_COMPOSE_PROVIDER=

# Optional TypeSafe Jev customer panel. Without these, the panel uses recorded responses
# and the live test is skipped. The endpoint is confirmed in HAC-14.
JEV_API_KEY=
JEV_BASE_URL=

# Set only the model provider used by the agent implementation.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Census data-loading scripts only.
CENSUS_API_KEY=

# Local public-data preparation only; defaults to duckdb on PATH.
DUCKDB_BIN=
