# Copy to .env.local and fill in. Never commit real values.

# Server-only Postgres connection for health, migrations and source imports.
# Local Docker default (set only in .env.local):
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hackprinceton
DATABASE_URL=

# Local Docker database only. Set POSTGRES_PASSWORD in .env.local (local default: postgres).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=hackprinceton

# Optional local engine selection; sudo is never enabled implicitly.
CONTAINER_ENGINE=docker
CONTAINER_USE_SUDO=0
PODMAN_COMPOSE_PROVIDER=

# Optional TypeSafe Jev customer panel (System One API). Without a key, evaluation uses the
# Huff fallback and the live test is skipped. JEV_BASE_URL defaults to https://api.typesafe.ai;
# JEV_MODEL defaults to jev-latest (GET /v1/models also lists jev-preview).
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=

# OpenAI intake and orchestrator model calls. Structured patches work without a key.
OPENAI_API_KEY=
# Optional model override; defaults to gpt-6-luna (tool calling, reasoning none).
OPENAI_MODEL=

# Optional Capital One Nessie v2 demo cash buffer. Server only; GitHub sign-in at
# https://v2.nessieisreal.com/account supplies the v2 key. Never use NEXT_PUBLIC_.
NESSIE_API_KEY=
NESSIE_BASE_URL=https://v2-prod-api.nessieisreal.com

# Census data-loading scripts only.
CENSUS_API_KEY=

# Local public-data preparation only; defaults to duckdb on PATH.
DUCKDB_BIN=
