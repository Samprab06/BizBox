{
  "name": "hackprinceton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/prepare-cesium.mjs && next dev",
    "build": "node scripts/prepare-cesium.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "tsx scripts/local-compose.ts up -d --build --wait db",
    "db:down": "tsx scripts/local-compose.ts --profile app down",
    "db:reset": "tsx scripts/reset-local-db.ts",
    "db:load": "tsx scripts/load-local-data.ts",
    "db:load:hosted": "tsx scripts/load-hosted-data.ts",
    "db:verify": "tsx scripts/verify-local-dev.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@langchain/core": "1.4.0",
    "@langchain/openai": "1.8.4",
    "@mapbox/vector-tile": "2.0.5",
    "@react-three/fiber": "9.8.2",
    "cesium": "1.147.0",
    "deepagents": "1.16.5",
    "drizzle-orm": "0.45.4",
    "maplibre-gl": "5.24.1",
    "next": "16.4.6",
    "pbf": "4.0.2",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.23",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
